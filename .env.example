PORT=3000
NODE_ENV=development
APP_NAME="Express Starter API"
CORS_ORIGIN=*

# Lingxing VC realtime sales exporter
INTERNAL_API_TOKEN=replace-with-a-long-random-token
LINGXING_USERNAME=
LINGXING_PASSWORD=
LINGXING_LOGIN_URL=https://erp.lingxing.com/login
LINGXING_VC_SALES_URL=https://erp.lingxing.com/erp/mreport/vcSalesStat
LINGXING_HEADLESS=true
LINGXING_BROWSER_EXECUTABLE_PATH=
LINGXING_STORAGE_STATE_PATH=./runtime/lingxing-storage-state.json
LINGXING_DOWNLOAD_DIR=./runtime/downloads
LINGXING_EXPORT_GLOBAL_AGGREGATION=false

# Java backend import API
JAVA_API_BASE_URL=http://127.0.0.1:8080
JAVA_API_INTERNAL_TOKEN=replace-with-the-same-token-as-java
JAVA_API_TIMEOUT_MS=300000

# Express scheduler: daily 16:10 Asia/Shanghai
VC_REALTIME_CRON_ENABLED=true
VC_REALTIME_CRON_EXPRESSION=10 16 * * *
VC_REALTIME_CRON_TIMEZONE=Asia/Shanghai
